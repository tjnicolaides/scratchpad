# Copy to .env and fill in. .env is gitignored — never commit real secrets.

# --- App-password spike account (use a THROWAWAY Bluesky account) ---
# Create one, then Settings -> App Passwords -> add one, paste it here.
ATP_HANDLE=you.bsky.social
ATP_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
PDS_SERVICE=https://bsky.social

# --- Poller ---
# Comma-separated handles the AppView indexes. Defaults to ATP_HANDLE if unset.
SEED_HANDLES=you.bsky.social

# --- Database ---
# After `netlify db init`, Netlify injects NETLIFY_DATABASE_URL automatically
# for both `netlify dev` and deploys — you do NOT need to set it here.
# For local dev WITHOUT netlify (e.g. a plain Neon branch), set this instead:
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
