{
  "name": "@scratchpad/lexicons",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Canonical atproto lexicon spec for the Yesterdays georeferencing project.",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./georef.json": "./lexicons/place.yesterdays.georef.json",
    "./photo.json": "./lexicons/place.yesterdays.photo.json"
  },
  "files": ["dist", "lexicons"],
  "dependencies": {
    "tslib": "^2.3.0"
  }
}
